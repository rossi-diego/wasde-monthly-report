# Dockerfile.api — FastAPI + static frontend + DuckDB data
FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src/ src/
RUN pip install --no-cache-dir hatchling && pip install --no-cache-dir -e "."

COPY frontend/ frontend/
RUN mkdir -p data/silver
COPY data/silver/ data/silver/
# DuckDB is optional — API falls back to in-memory if missing
COPY data/wasde.duckd[b] data/

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:${PORT:-8000}/health')"

# Render injects $PORT at runtime
CMD uvicorn wasde.api.main:app --host 0.0.0.0 --port ${PORT:-8000}
