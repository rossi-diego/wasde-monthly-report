# All variables are optional; defaults work out of the box. Prefix: WASDE_
# Where bronze/silver/gold/publish files live.
WASDE_DATA_DIR=data
# Where the site's JSON/Parquet/download files are written.
WASDE_WEB_DATA_DIR=web/public/data
# Logging: level and JSON output (JSON is forced on in GitHub Actions).
WASDE_LOG_LEVEL=INFO
WASDE_LOG_JSON=false
# First report to backfill (XML history starts 2010-07).
WASDE_HISTORY_START=2010-07
# Minimum rows for a report to be considered complete.
WASDE_MIN_ROWS_PER_REPORT=3500
# USDA's CDN rejects non-browser user agents (HTTP 403); override only if that changes.
# WASDE_USER_AGENT=Mozilla/5.0 ...

# GitHub Actions secrets/variables (not read locally):
#   secret VERCEL_TOKEN       Vercel access token used to deploy the site
#   secret HEALTHCHECK_URL    optional healthchecks.io ping URL (alerts if runs stop)
#   var    VERCEL_SCOPE       optional Vercel team slug
#   var    SITE_URL           production URL checked after each deploy
