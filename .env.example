# All variables are optional; defaults work out of the box. Prefix: USDA_
# (The old WASDE_ prefix is still read for one release, with a deprecation log line.)

# Where bronze/silver/gold/publish files live.
USDA_DATA_DIR=data
# Optional separate bronze store location (default: $USDA_DATA_DIR/bronze).
# USDA_BRONZE_PATH=/mnt/bronze
# Where the site's JSON/Parquet/download files are written.
USDA_WEB_DATA_DIR=web/public/data
# Logging: level and JSON output (JSON is forced on in GitHub Actions).
USDA_LOG_LEVEL=INFO
USDA_LOG_JSON=false
# First WASDE report to backfill (XML history starts 2010-07).
USDA_HISTORY_START=2010-07
# Override the minimum rows per WASDE report from config/contracts/wasde.yaml (default 3500).
# USDA_MIN_ROWS_PER_REPORT=3500
# USDA's CDN rejects non-browser user agents (HTTP 403); override only if that changes.
# USDA_USER_AGENT=Mozilla/5.0 ...

# API keys (no USDA_ prefix). None is needed for WASDE.
# FAS Export Sales (api.fas.usda.gov, api.data.gov key). Falls back to USDA_PSD_KEY when unset.
# FAS_API_KEY=
# USDA_PSD_KEY=
# Optional NASS Quick Stats key (not used in v1; free signup at quickstats.nass.usda.gov/api).
# NASS_API_KEY=

# GitHub Actions secrets/variables (not read locally):
#   secret VERCEL_TOKEN       Vercel access token used to deploy the site
#   secret USDA_PSD_KEY       api.data.gov key (FAS PSD / Export Sales)
#   secret HEALTHCHECK_URL    optional healthchecks.io ping URL (alerts if runs stop)
#   var    VERCEL_SCOPE       optional Vercel team slug
#   var    SITE_URL           production URL checked after each deploy
